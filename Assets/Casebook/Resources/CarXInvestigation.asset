    title: "\u0417\u0430\u043F\u0438\u0441\u044C \u0441 \u0430\u0432\u0442\u043E\u043E\u0442\u0432\u0435\u0442\u0447\u0438\u043A\u0430"
    section: 0
    location: "\u041A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u043E\u0442\u0446\u0430"
    time: "19:15 \u0438 21:40"
    observation: "19:15 \u2014 \u0433\u0443\u0434\u043A\u0438, \u0441\u0442\u0443\u043A \u0438 \u0434\u0430\u043B\u0451\u043A\u0438\u0439 \u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0439 \u0433\u0443\u0434\u043E\u043A. 21:40 \u2014 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0414\u043C\u0438\u0442\u0440\u0438\u044E \u0443\u0433\u0440\u043E\u0437\u0443. \u0422\u043E\u0432\u0430\u0440 \u0438\u043B\u0438 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u044B\u0441\u044F\u0447 \u0434\u043E \u0443\u0442\u0440\u0430 \u043F\u044F\u0442\u043D\u0438\u0446\u044B. \u041D\u0430 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u043C \u043F\u0438\u0440\u0441\u0435 \u0432\u0441\u043A\u0440\u044B\u0442 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440, \u0431\u0443\u043C\u0430\u0433\u0438 \u043F\u0440\u043E\u043F\u0430\u043B\u0438."
    narrator: "\u041F\u0435\u0440\u0432\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C \u043F\u043E\u0447\u0442\u0438 \u0441\u0442\u0451\u0440\u0442\u0430. \u041D\u0430\u0434\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0414\u043C\u0438\u0442\u0440\u0438\u044F \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0441\u043C\u0435\u043D\u0443 \u043E\u0442\u0446\u0430 \u0432 \u043F\u043E\u0440\u0442\u0443."
