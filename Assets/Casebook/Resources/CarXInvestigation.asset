    hint: "\u0427\u0430\u0441\u044B \u0438 \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438. \u0412 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u043E \u0442\u043E\u0432\u0430\u0440\u0435 \u0438 \u0431\u0443\u043C\u0430\u0433\u0430\u0445. \u0411\u043E\u0440\u0438\u0441 \u043C\u043E\u0433 \u0432\u0438\u0434\u0435\u0442\u044C, \u0447\u0442\u043E \u043E\u0442\u0435\u0446 \u043F\u0440\u0438\u043D\u044F\u043B \u0432 \u043B\u043E\u043C\u0431\u0430\u0440\u0434\u0435."
  - id: concl_guest
    first: clue_door_lock
    second: clue_valuables
    title: "\u041E\u0442\u0435\u0446 \u043C\u043E\u0433 \u0437\u043D\u0430\u0442\u044C \u0433\u043E\u0441\u0442\u044F"
    hint: "\u0417\u0430\u043C\u043E\u043A \u0446\u0435\u043B. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u0442\u0435\u0446 \u0432\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u0433\u043E-\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E, \u0430 \u043E\u0431\u044B\u0441\u043A \u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0443\u0436\u0435 \u043F\u043E\u0441\u043B\u0435."
