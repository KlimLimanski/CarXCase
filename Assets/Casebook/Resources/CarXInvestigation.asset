  entries:
  - id: clue_record
    title: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430 \u043E\u0442\u0446\u0430"
    section: 0
    location: "\u041A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u043E\u0442\u0446\u0430"
    time: 
    observation: "\u041D\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0434\u0436\u0430\u0437\u043E\u0432\u0430\u044F \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430. \u041E\u043D\u0430 \u043B\u0435\u0436\u0438\u0442 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439 \u0411 \u0432\u0432\u0435\u0440\u0445, \u0440\u044F\u0434\u043E\u043C \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442."
    narrator: "\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0411. \u041F\u043E \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u044F\u043C \u043E\u0442\u0435\u0446 \u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0451, \u043F\u043E\u043A\u0430 \u0432\u0430\u0440\u0438\u043B \u043A\u043E\u0444\u0435. \u042F \u0435\u0449\u0451 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B \u0433\u043B\u0430\u0437\u0430, \u0430 \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443 \u0449\u0435\u043B\u0447\u043A\u0443 \u0443\u0436\u0435 \u0437\u043D\u0430\u043B: \u043F\u0430\u043F\u0430 \u0434\u043E\u043C\u0430."
    attachments: []
    revealedBy: []
  - id: clue_door_lock
    title: "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0438\u0437\u043D\u0443\u0442\u0440\u0438"
    section: 0
    location: "\u041A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u043E\u0442\u0446\u0430"
    time: 
    observation: "\u041B\u0438\u0447\u0438\u043D\u043A\u0430 \u0438 \u043A\u043E\u0441\u044F\u043A \u0446\u0435\u043B\u044B. \u041D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u043B\u0435\u0436\u0430\u0442 \u043A\u043B\u044E\u0447\u0438 \u043E\u0442\u0446\u0430 \u0441 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u043C \u044F\u043A\u043E\u0440\u0435\u043C."
    narrator: "\u0421\u043B\u0435\u0434\u043E\u0432 \u043B\u043E\u043C\u0430 \u0438\u043B\u0438 \u043E\u0442\u043C\u044B\u0447\u043A\u0438 \u043D\u0435\u0442. \u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u0442\u0435\u0446 \u0441\u0430\u043C \u0432\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u0433\u043E-\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E."
    attachments: []
    revealedBy: []
  - id: clue_valuables
    title: "\u0426\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442\u044B"
    section: 0
    location: "\u041A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u043E\u0442\u0446\u0430"
    time: 
    observation: "\u042D\u041B\u0422-\u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440, \u0447\u0430\u0441\u044B \xAB\u041F\u043E\u0431\u0435\u0434\u0430\xBB \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043F\u043E\u0440\u0442\u0441\u0438\u0433\u0430\u0440 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u042F\u0449\u0438\u043A\u0438 \u0432\u044B\u0432\u0435\u0440\u043D\u0443\u0442\u044B."
    narrator: "\u041E\u0431\u044B\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0431\u044B \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440 \u0438 \u0447\u0430\u0441\u044B. \u0417\u0434\u0435\u0441\u044C \u0438\u0441\u043A\u0430\u043B\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0432\u0435\u0449\u044C \u0438\u043B\u0438 \u0431\u0443\u043C\u0430\u0433\u0438."
