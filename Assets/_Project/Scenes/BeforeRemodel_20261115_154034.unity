  clueId: clue_secret_note
  clueTitle: "\u0421\u043C\u044F\u0442\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u043A\u0430"
  clueDescription: "\u041F\u043E\u0434 \u043A\u0440\u043E\u0432\u0430\u0442\u044C\u044E, \u0443 \u0441\u0430\u043C\u043E\u0439 \u0441\u0442\u0435\u043D\u044B: \xAB\u041F\u0430\u043F\u0430, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u041B\u0451\u0448\u0435. \u042F \u0432\u0441\u0451 \u0432\u0435\u0440\u043D\u0443 \u0434\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u044B. \u041C.\xBB \u041F\u043E\u0447\u0435\u0440\u043A \u041C\u0438\u0445\u0430\u0438\u043B\u0430."
  isSuspiciousForBrothers: 1
  targetRenderer: {fileID: 2056498542}
  highlightColor: {r: 1, g: 0.85, b: 0.4, a: 1}
