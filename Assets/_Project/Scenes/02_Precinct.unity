  establishingShot: {fileID: 361492143}
  walkSpeed: 1.7
  walkStart: 2.2
  dialogue:
  - start: 5
    end: 8.6
    speaker: "\u0414\u0415\u0416\u0423\u0420\u041D\u042B\u0419"
    text: "\u0412\u043E\u043B\u043A\u043E\u0432? \u0422\u044B \u0436\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439. \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u043F\u0440\u043E \u0442\u0435\u0431\u044F \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B."
  - start: 8.8
    end: 11.6
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041F\u043E\u0442\u043E\u043C. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043A\u043E\u0435-\u0447\u0442\u043E \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u043E \u043F\u043E\u043B\u043E\u0447\u043A\u0430\u043C."
  - start: 12.6
    end: 15.6
    speaker: "\u0414\u0415\u0422\u0415\u041A\u0422\u0418\u0412"
    text: "\u0421\u043B\u044B\u0448\u0430\u043B \u043F\u0440\u043E \u0442\u0432\u043E\u0435\u0433\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u0430. \u0415\u0441\u043B\u0438 \u0447\u0442\u043E \u2014 \u043C\u044B \u0440\u044F\u0434\u043E\u043C, \u041B\u0451\u0445\u0430."
  - start: 15.8
    end: 17.2
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
  title: "13-\u0419 \u0423\u0427\u0410\u0421\u0422\u041E\u041A \xB7 \u0411\u0420\u0423\u041A\u041B\u0418\u041D"
  subtitle: "\u0422\u043E\u0442 \u0436\u0435 \u0432\u0435\u0447\u0435\u0440"
