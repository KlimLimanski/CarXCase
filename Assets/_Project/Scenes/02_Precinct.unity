    title: "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0438\u0437\u043D\u0443\u0442\u0440\u0438"
    description: "\u041B\u0438\u0447\u0438\u043D\u043A\u0430 \u0438 \u043A\u043E\u0441\u044F\u043A \u0446\u0435\u043B\u044B. \u041D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u043B\u0435\u0436\u0430\u0442 \u043A\u043B\u044E\u0447\u0438 \u043E\u0442\u0446\u0430 \u0441 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u043C \u044F\u043A\u043E\u0440\u0435\u043C."
  - id: clue_valuables
    title: "\u0426\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442\u044B"
    description: "\u042D\u041B\u0422-\u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440, \u0447\u0430\u0441\u044B \xAB\u041F\u043E\u0431\u0435\u0434\u0430\xBB \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043F\u043E\u0440\u0442\u0441\u0438\u0433\u0430\u0440 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u042F\u0449\u0438\u043A\u0438 \u0432\u044B\u0432\u0435\u0440\u043D\u0443\u0442\u044B."
  - id: clue_bar_matches
    title: "\u041A\u043E\u0440\u043E\u0431\u043E\u043A \u0438\u0437 \u0431\u0430\u0440\u0430 \xAB\u0421\u0442\u0435\u0440\u043B\u044F\u0434\u044C\xBB"
    description: "\u041D\u0430 \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0435 \u043B\u0435\u0436\u0438\u0442 \u043A\u043E\u0440\u043E\u0431\u043E\u043A \u0441 \u043E\u0441\u0435\u0442\u0440\u043E\u043C \u0438 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E \xAB\u0421\u0442\u0435\u0440\u043B\u044F\u0434\u044C\xBB."
  - id: clue_answering_machine
    title: "\u0417\u0430\u043F\u0438\u0441\u044C \u0441 \u0430\u0432\u0442\u043E\u043E\u0442\u0432\u0435\u0442\u0447\u0438\u043A\u0430"
    description: "19:15 \u2014 \u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0439 \u0433\u0443\u0434\u043E\u043A. 21:40 \u2014 \u0443\u0433\u0440\u043E\u0437\u0430 \u0414\u043C\u0438\u0442\u0440\u0438\u044E \u0438 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0435 \u0431\u0443\u043C\u0430\u0433\u0438 \u0441 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E \u043F\u0438\u0440\u0441\u0430."
  - id: clue_record
    title: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430 \u043E\u0442\u0446\u0430"
    description: "\u041D\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0434\u0436\u0430\u0437\u043E\u0432\u0430\u044F \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430. \u041E\u043D\u0430 \u043B\u0435\u0436\u0438\u0442 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439 \u0411 \u0432\u0432\u0435\u0440\u0445, \u0440\u044F\u0434\u043E\u043C \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442."
  deductions:
  - id: concl_dmitry_bar
    clueA: clue_bar_matches
    clueB: clue_answering_machine
    title: "\u0411\u0430\u0440 \u0414\u043C\u0438\u0442\u0440\u0438\u044F"
    text: "\u0412 \u0437\u0430\u043F\u0438\u0441\u0438 \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0414\u043C\u0438\u0442\u0440\u0438\u044F \u0438 \u0435\u0433\u043E \u0431\u0430\u0440. \u0421\u043F\u0440\u043E\u0448\u0443 \u041C\u0438\u0442\u044C\u043A\u0443, \u043F\u043E\u0447\u0435\u043C\u0443 \u0437\u0432\u043E\u043D\u0438\u0432\u0448\u0438\u0439 \u0441\u0432\u044F\u0437\u0430\u043B \u0435\u0433\u043E \u0441 \u043E\u0442\u0446\u043E\u043C."
  - id: concl_father_port
    clueA: clue_valuables
    clueB: clue_answering_machine
    title: "\u041F\u043E\u0440\u0442 \xB7 \u043F\u043E\u0435\u0437\u0434\u043A\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430"
    text: "\u0426\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438, \u0430 \u0432 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0440\u043E \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0435 \u0431\u0443\u043C\u0430\u0433\u0438 \u0438 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u043F\u0438\u0440\u0441. \u041D\u0430\u0434\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0443 \u043E\u0442\u0446\u0430. \u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u043F\u043E\u043A\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430."
  - id: concl_guest
    clueA: clue_door_lock
    clueB: clue_valuables
    title: "\u041E\u0442\u0435\u0446 \u043C\u043E\u0433 \u0437\u043D\u0430\u0442\u044C \u0433\u043E\u0441\u0442\u044F"
    text: "\u0417\u0430\u043C\u043E\u043A \u0446\u0435\u043B. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u0442\u0435\u0446 \u0432\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u0433\u043E-\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E, \u0430 \u043E\u0431\u044B\u0441\u043A \u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0443\u0436\u0435 \u043F\u043E\u0441\u043B\u0435."
  options:
  - label: "\u0411\u0430\u0440 \u0414\u043C\u0438\u0442\u0440\u0438\u044F"
    requiresConclusion: concl_dmitry_bar
    targetScene: 03_Bar
    outcome: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u0432 \u0431\u0430\u0440 \xAB\u0421\u0442\u0435\u0440\u043B\u044F\u0434\u044C\xBB. \u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0414\u043C\u0438\u0442\u0440\u0438\u044F \u043E \u0437\u0432\u043E\u043D\u043A\u0435 \u0438 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0432\u0438\u0434\u0435\u043B \u043E\u0442\u0446\u0430."
    unavailableStatus: 
  - label: "\u041F\u043E\u0440\u0442 \xB7 \u0440\u0430\u0431\u043E\u0442\u0430 \u043E\u0442\u0446\u0430"
    requiresConclusion: concl_father_port
    targetScene: 
    outcome: "\u041E\u0442\u0435\u0446 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u043F\u043E\u0440\u0442\u0443. \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u043F\u0438\u0440\u0441 \u0438 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0435 \u0431\u0443\u043C\u0430\u0433\u0438 \u2014 \u0437\u0430\u0446\u0435\u043F\u043A\u0438 \u043E \u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0441\u043C\u0435\u043D\u0435."
    unavailableStatus: "\u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u043E. \u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u043F\u043E\u043A\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430."
  conclusionsForDecision: 2
  requiredConclusions:
  - concl_dmitry_bar
  - concl_father_port
