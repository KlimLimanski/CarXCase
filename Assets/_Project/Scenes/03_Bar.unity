  successText: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043E\u0439\u043A\u0443: \xAB\u0421\u0442\u0430\u0440\u044B\u0439 \u0441\u043A\u043B\u0430\u0434 \u0440\u0435\u0444\u0440\u0438\u0436\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442-\u0441\u0442\u0440\u0438\u0442. \u0420\u0435\u0437\u043E \u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0430\u043C \u0434\u043E\u043B\u0436\u043D\u0438\u043A\u043E\u0432. \u042F \u0442\u0435\u0431\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\xBB.\n\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0433\u0434\u0435 \u0438\u0441\u043A\u0430\u0442\u044C \u043E\u0442\u0446\u0430."
  failText: "\xAB\u041F\u0435\u0439 \u0438\u043B\u0438 \u0443\u0445\u043E\u0434\u0438\xBB, \u2014 \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043A \u043F\u043E\u043B\u043A\u0430\u043C. \u0417\u0430\u0446\u0435\u043F\u043A\u0430 \u0432 \u0431\u0430\u0440\u0435 \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C, \u0430 \u043B\u044E\u0434\u0438 \u0420\u0435\u0437\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u044E\u0442, \u0447\u0442\u043E \u0442\u044B \u0438\u0445 \u0438\u0449\u0435\u0448\u044C."
