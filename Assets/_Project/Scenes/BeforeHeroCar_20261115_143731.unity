  dialogue:
  - start: 9
    end: 14
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041C\u0438\u0448\u0430? \u042F \u0443\u0436\u0435 \u043D\u0430 \u0411\u0440\u0430\u0439\u0442\u043E\u043D\u0435. \u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
  - start: 16
    end: 22
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u0423 \u043C\u0435\u043D\u044F \u043D\u0438\u0447\u0435\u0433\u043E. \u041E\u0442\u0435\u0446 \u0441\u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442."
  - start: 25
    end: 31
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041E\u043D \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u0422\u044B \u0436\u0435 \u0435\u0433\u043E \u0437\u043D\u0430\u0435\u0448\u044C."
  - start: 34
    end: 41
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u0417\u043D\u0430\u044E. \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u043D \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B \u043C\u0430\u0433\u0430\u0437\u0438\u043D. \u0421\u043E\u0441\u0435\u0434\u043A\u0430 \u0437\u0432\u043E\u043D\u0438\u043B\u0430 \u043C\u043D\u0435 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443."
  - start: 44
    end: 50
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041C\u043E\u0436\u0435\u0442, \u0443\u0448\u0451\u043B \u043F\u043E \u0434\u0435\u043B\u0430\u043C. \u042F \u0437\u0430\u0435\u0434\u0443, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E."
  - start: 53
    end: 60
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u0412\u0447\u0435\u0440\u0430 \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u043B \u043D\u0430\u0439\u0442\u0438 \u0442\u0435\u0431\u044F. \u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043B\u0438\u0447\u043D\u043E."
  - start: 63
    end: 69
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041E \u0447\u0451\u043C? \u0412\u044B \u043E\u043F\u044F\u0442\u044C \u043F\u043E\u0441\u0441\u043E\u0440\u0438\u043B\u0438\u0441\u044C?"
  - start: 72
    end: 79
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u041D\u0435\u0442. \u0412 \u0442\u043E\u043C-\u0442\u043E \u0438 \u0434\u0435\u043B\u043E. \u041E\u043D \u0431\u044B\u043B \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0442\u0438\u0445\u0438\u0439. \u0412\u0441\u0451 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B, \u043E\u0434\u0438\u043D \u043B\u0438 \u044F."
  - start: 83
    end: 90
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041B\u0430\u0434\u043D\u043E. \u0414\u043E \u0434\u043E\u043C\u0430 \u0435\u0449\u0451 \u043F\u0430\u0440\u0430 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u043E\u0432. \u041A\u043B\u044E\u0447 \u0443 \u043C\u0435\u043D\u044F \u043E\u0441\u0442\u0430\u043B\u0441\u044F."
  - start: 94
    end: 101
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u041B\u0451\u0448\u2026 \u0415\u0441\u043B\u0438 \u043E\u043D \u0434\u043E\u043C\u0430, \u043F\u0443\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442. \u041D\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0439 \u0441 \u043D\u0438\u043C \u0441\u043F\u043E\u0440\u0438\u0442\u044C."
  - start: 105
    end: 111
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u042F \u0435\u0434\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u043A\u0430\u043A \u043E\u043D. \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E."
  - start: 115
    end: 122
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u042F \u0431\u0443\u0434\u0443 \u0443 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430."
  - start: 129
    end: 135
    speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u0412\u0438\u0436\u0443 \u0434\u043E\u043C. \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u0438\u043F\u0430\u0440\u043A\u0443\u044E\u0441\u044C. \u041F\u043E\u0437\u0432\u043E\u043D\u044E \u0438\u0437 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B."
  - start: 137
    end: 141
    speaker: "\u041C\u0418\u0425\u0410\u0418\u041B \xB7 \u041F\u041E \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u0423"
    text: "\u0414\u0430\u0432\u0430\u0439. \u0418\u2026 \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
  dynamicCamera: 1
  cameraMotionAmount: 1
