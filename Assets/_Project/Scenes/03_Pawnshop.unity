  shutdownTitle: "\u0414\u041E\u041F\u0420\u041E\u0421 \u0421\u041E\u0420\u0412\u0410\u041D"
  successText: "\u041F\u043E\u0437\u0430\u0432\u0447\u0435\u0440\u0430 \u043E\u043D\u0438 \u0432\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C \u043F\u0435\u0440\u0435\u0434 \u043C\u043E\u0435\u0439 \u0441\u043C\u0435\u043D\u043E\u0439. \u0421\u043A\u0430\u0437\u0430\u043B\u0438, \u0424\u0451\u0434\u043E\u0440 \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u044B\u0441\u044F\u0447 \u0438 \u0443\u0436\u0435 \u0443 \u043D\u0438\u0445 \xAB\u0432 \u0433\u043E\u0441\u0442\u044F\u0445\xBB.\n\u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u044B\u043B \u043A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u044B\u0439, \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C \u043D\u0430 \u0449\u0435\u043A\u0435. \u041E\u043D \u0432\u0435\u043B\u0435\u043B \u0433\u043D\u0430\u0442\u044C \u043C\u0430\u0448\u0438\u043D\u0443 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u043F\u0440\u0438\u0447\u0430\u043B, \u043F\u043E\u043A\u0430 \u043E\u0445\u0440\u0430\u043D\u0430 \u043D\u0435 \u0441\u043C\u0435\u043D\u0438\u043B\u0430\u0441\u044C.\n\u042D\u0442\u043E \u0428\u0438\u043F\u0441\u0445\u0435\u0434-\u0411\u0435\u0439, \u041B\u0451\u0448\u0430. \u041F\u043E\u0440\u0442\u043E\u0432\u0430\u044F \u043C\u0430\u0444\u0438\u044F \u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0430\u043C \u0441\u0442\u0430\u0440\u044B\u0439 \u0430\u043D\u0433\u0430\u0440. \u041D\u043E\u043C\u0435\u0440 \u0447\u0435\u0442\u044B\u0440\u0435."
  failText: "\u0421\u0451\u043C\u0430 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0435 \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0430\u0434\u0432\u043E\u043A\u0430\u0442\u0430. \u0421\u0435\u0439\u0444 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C \u2014 \u0430 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C \u0438 \u0442\u0430\u0439\u043D\u0430 \u043B\u043E\u043C\u0431\u0430\u0440\u0434\u0430."
  shutdownText: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u044E \u0438 \u0437\u043D\u0430\u0442\u044C \u043D\u0435 \u0445\u043E\u0447\u0443! \u0423 \u043C\u0435\u043D\u044F \u0432\u043D\u0443\u043A\u0438. \u0423\u0445\u043E\u0434\u0438 \u043E\u0442\u0441\u044E\u0434\u0430!"
