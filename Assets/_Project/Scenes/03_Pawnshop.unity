MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 962085735}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1e4abc27b2a98e4c9f7b5a1c378cd4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DetectiveGame.Core.ClueObject
  clueId: clue_pawnshop_hangar_note
  clueTitle: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u0438\u0437 \u0441\u0435\u0439\u0444\u0430"
  clueDescription: "\u0412\u0440\u0435\u043C\u044F \u0432\u044B\u0448\u043B\u043E, \u0441\u0442\u0430\u0440\u0438\u043A. \u0416\u0434\u0451\u043C \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438 \u0432 \u043F\u043E\u043B\u043D\u043E\u0447\u044C \u043D\u0430 \u043F\u0440\u0438\u0447\u0430\u043B\u0435 \u0428\u0438\u043F\u0441\u0445\u0435\u0434-\u0411\u0435\u0439, \u0441\u0442\u0430\u0440\u044B\u0439 \u0430\u043D\u0433\u0430\u0440 \u21164. \u041F\u0440\u0438\u0434\u0451\u0448\u044C \u0431\u0435\u0437 \u0434\u0435\u043D\u0435\u0433 \u2014 \u043F\u0435\u043D\u044F\u0439 \u043D\u0430 \u0441\u0435\u0431\u044F."
  isSuspiciousForBrothers: 1
  addToJournal: 1
  journalAttachments: []
  inspectionComment: "\u041F\u043E\u043B\u043D\u043E\u0447\u044C. \u041F\u0440\u0438\u0447\u0430\u043B \u0428\u0438\u043F\u0441\u0445\u0435\u0434-\u0411\u0435\u0439, \u0441\u0442\u0430\u0440\u044B\u0439 \u0430\u043D\u0433\u0430\u0440 \u043D\u043E\u043C\u0435\u0440 \u0447\u0435\u0442\u044B\u0440\u0435. \u041E\u0442\u0446\u0430 \u0436\u0434\u0443\u0442 \u0442\u0430\u043C."
  journalThought: "\u041F\u043E\u043B\u043D\u043E\u0447\u044C. \u041F\u0440\u0438\u0447\u0430\u043B \u0428\u0438\u043F\u0441\u0445\u0435\u0434-\u0411\u0435\u0439, \u0441\u0442\u0430\u0440\u044B\u0439 \u0430\u043D\u0433\u0430\u0440 \u043D\u043E\u043C\u0435\u0440 \u0447\u0435\u0442\u044B\u0440\u0435. \u041E\u0442\u0446\u0430 \u0436\u0434\u0443\u0442 \u0442\u0430\u043C."
  cameraShot: 4
  targetRenderer: {fileID: 962085737}
  highlightRenderers: []
  highlightColor: {r: 1, g: 0.85, b: 0.4, a: 1}
