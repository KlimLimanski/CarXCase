  grantId: clue_boris_hangar
  grantTitle: "\u041F\u0440\u044F\u043C\u0430\u044F \u043D\u0430\u0432\u043E\u0434\u043A\u0430 \u0411\u043E\u0440\u0438\u0441\u0430"
  grantText: "\u041E\u0442\u0435\u0446 \u0443 \u043B\u044E\u0434\u0435\u0439 \u0441\u043E \u0441\u0442\u0430\u0440\u044B\u0445 \u043F\u0440\u0438\u0447\u0430\u043B\u043E\u0432 \u0432 \u0428\u0438\u043F\u0441\u0445\u0435\u0434-\u0411\u0435\u0439. \u0411\u043E\u0440\u0438\u0441 \u0443\u043A\u0430\u0437\u0430\u043B \u043D\u0430 \u0430\u043D\u0433\u0430\u0440 \u21164 \u0438 \u043E\u043F\u0438\u0441\u0430\u043B \u043A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u043E\u0433\u043E \u0433\u043B\u0430\u0432\u0430\u0440\u044F \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C."
  returnScene: 05_BrightonHarbor
  travelLabel: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u0432 \u0428\u0438\u043F\u0441\u0445\u0435\u0434-\u0411\u0435\u0439"
  autoTravelDelay: 0
  recoveryAction: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435"
  recoveryClueId: 
  recoveryClueTitle: "\u041A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044F \u0441 \u0430\u0434\u0440\u0435\u0441\u043E\u043C \u0441\u043A\u043B\u0430\u0434\u0430"
  revealHarborCode: 0
  recoveryClueText: "\u0412 \u043A\u043E\u043F\u0438\u0438 \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u0430\u0434\u0440\u0435\u0441 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u0430 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442-\u0441\u0442\u0440\u0438\u0442 \u0438 \u043D\u043E\u043C\u0435\u0440 \u043F\u0438\u0440\u0441\u0430 3."
