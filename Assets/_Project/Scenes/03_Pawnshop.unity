      heroLine: "\u0412\u044B \u043D\u0430 \u043E\u0442\u0446\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435, \u043E\u043D \u0432\u0430\u0441 \u043A\u0430\u043A \u0431\u0440\u0430\u0442\u0430 \u0434\u0435\u0440\u0436\u0430\u043B. \u0421\u043A\u0430\u0436\u0438\u0442\u0435 \u0447\u0435\u0441\u0442\u043D\u043E, \u0447\u0442\u043E \u0437\u0430 \u0440\u0435\u0431\u044F\u0442\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438?"
      probability: 20
      stress: 0
      next: evidence
      requires: 
