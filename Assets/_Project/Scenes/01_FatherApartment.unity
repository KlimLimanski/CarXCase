  clueId: clue_bar_matches
  clueTitle: "\u041A\u043E\u0440\u043E\u0431\u043E\u043A \u0438\u0437 \u0431\u0430\u0440\u0430 \xAB\u0421\u0442\u0435\u0440\u043B\u044F\u0434\u044C\xBB"
  clueDescription: "\u041D\u0430 \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0435 \u043B\u0435\u0436\u0438\u0442 \u043A\u043E\u0440\u043E\u0431\u043E\u043A \u0441 \u043E\u0441\u0435\u0442\u0440\u043E\u043C \u0438 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E \xAB\u0421\u0442\u0435\u0440\u043B\u044F\u0434\u044C\xBB."
  isSuspiciousForBrothers: 1
  addToJournal: 1
  journalAttachments: []
  inspectionComment: "\u0421\u043F\u0438\u0447\u043A\u0438 \u0438\u0437 \u041C\u0438\u0442\u044C\u043A\u0438\u043D\u043E\u0433\u043E \u0431\u0430\u0440\u0430. \u0418\u0445 \u043C\u043E\u0433 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043E\u0442\u0435\u0446. \u0418\u043B\u0438 \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C \u0432\u0447\u0435\u0440\u0430."
  journalThought: "\u0421\u043F\u0438\u0447\u043A\u0438 \u0438\u0437 \u041C\u0438\u0442\u044C\u043A\u0438\u043D\u043E\u0433\u043E \u0431\u0430\u0440\u0430. \u0418\u0445 \u043C\u043E\u0433 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043E\u0442\u0435\u0446. \u0418\u043B\u0438 \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C \u0432\u0447\u0435\u0440\u0430."
