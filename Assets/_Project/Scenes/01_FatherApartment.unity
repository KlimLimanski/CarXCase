--- !u!114 &9189609232728299173
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8903782113407107984}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1e4abc27b2a98e4c9f7b5a1c378cd4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DetectiveGame.Core.ClueObject
  clueId: clue_record
  clueTitle: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430 \u043E\u0442\u0446\u0430"
  clueDescription: "\u041D\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0434\u0436\u0430\u0437\u043E\u0432\u0430\u044F \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430. \u041E\u043D\u0430 \u043B\u0435\u0436\u0438\u0442 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439 \u0411 \u0432\u0432\u0435\u0440\u0445, \u0440\u044F\u0434\u043E\u043C \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442."
  isSuspiciousForBrothers: 0
  addToJournal: 1
  journalAttachments: []
  inspectionComment: "\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0411. \u041F\u043E \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u044F\u043C \u043E\u0442\u0435\u0446 \u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0451, \u043F\u043E\u043A\u0430 \u0432\u0430\u0440\u0438\u043B \u043A\u043E\u0444\u0435. \u042F \u0435\u0449\u0451 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B \u0433\u043B\u0430\u0437\u0430, \u0430 \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443 \u0449\u0435\u043B\u0447\u043A\u0443 \u0443\u0436\u0435 \u0437\u043D\u0430\u043B: \u043F\u0430\u043F\u0430 \u0434\u043E\u043C\u0430."
  journalThought: "\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0411. \u041F\u043E \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u044F\u043C \u043E\u0442\u0435\u0446 \u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0451, \u043F\u043E\u043A\u0430 \u0432\u0430\u0440\u0438\u043B \u043A\u043E\u0444\u0435. \u042F \u0435\u0449\u0451 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B \u0433\u043B\u0430\u0437\u0430, \u0430 \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443 \u0449\u0435\u043B\u0447\u043A\u0443 \u0443\u0436\u0435 \u0437\u043D\u0430\u043B: \u043F\u0430\u043F\u0430 \u0434\u043E\u043C\u0430."
  cameraShot: 4
  targetRenderer: {fileID: 1921163551}
