  m_Script: {fileID: 11500000, guid: d1e4abc27b2a98e4c9f7b5a1c378cd4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DetectiveGame.Core.ClueObject
  clueId: clue_door_lock
  clueTitle: "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0438\u0437\u043D\u0443\u0442\u0440\u0438"
  clueDescription: "\u041B\u0438\u0447\u0438\u043D\u043A\u0430 \u0438 \u043A\u043E\u0441\u044F\u043A \u0446\u0435\u043B\u044B. \u041D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u043B\u0435\u0436\u0430\u0442 \u043A\u043B\u044E\u0447\u0438 \u043E\u0442\u0446\u0430 \u0441 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u043C \u044F\u043A\u043E\u0440\u0435\u043C."
  isSuspiciousForBrothers: 1
  addToJournal: 1
  journalAttachments: []
  inspectionComment: "\u0421\u043B\u0435\u0434\u043E\u0432 \u043B\u043E\u043C\u0430 \u0438\u043B\u0438 \u043E\u0442\u043C\u044B\u0447\u043A\u0438 \u043D\u0435\u0442. \u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u0442\u0435\u0446 \u0441\u0430\u043C \u0432\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u0433\u043E-\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E."
  journalThought: "\u0421\u043B\u0435\u0434\u043E\u0432 \u043B\u043E\u043C\u0430 \u0438\u043B\u0438 \u043E\u0442\u043C\u044B\u0447\u043A\u0438 \u043D\u0435\u0442. \u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u0442\u0435\u0446 \u0441\u0430\u043C \u0432\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u0433\u043E-\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E."
