  m_Script: {fileID: 11500000, guid: d1e4abc27b2a98e4c9f7b5a1c378cd4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DetectiveGame.Core.ClueObject
  clueId: clue_valuables
  clueTitle: "\u0426\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442\u044B"
  clueDescription: "\u042D\u041B\u0422-\u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440, \u0447\u0430\u0441\u044B \xAB\u041F\u043E\u0431\u0435\u0434\u0430\xBB \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043F\u043E\u0440\u0442\u0441\u0438\u0433\u0430\u0440 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u042F\u0449\u0438\u043A\u0438 \u0432\u044B\u0432\u0435\u0440\u043D\u0443\u0442\u044B."
  isSuspiciousForBrothers: 1
  addToJournal: 1
  journalAttachments: []
  inspectionComment: "\u041E\u0431\u044B\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0431\u044B \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440 \u0438 \u0447\u0430\u0441\u044B. \u0417\u0434\u0435\u0441\u044C \u0438\u0441\u043A\u0430\u043B\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0432\u0435\u0449\u044C \u0438\u043B\u0438 \u0431\u0443\u043C\u0430\u0433\u0438."
  journalThought: "\u041E\u0431\u044B\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0431\u044B \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440 \u0438 \u0447\u0430\u0441\u044B. \u0417\u0434\u0435\u0441\u044C \u0438\u0441\u043A\u0430\u043B\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0432\u0435\u0449\u044C \u0438\u043B\u0438 \u0431\u0443\u043C\u0430\u0433\u0438."
