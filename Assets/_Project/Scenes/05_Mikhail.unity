--- !u!114 &1788511389
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1788511388}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35b03f60472157540a422032ecd32a7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarXCase.Precinct.Interrogation
  suspectName: "\u041C\u0418\u0425\u0410\u0418\u041B"
  heroName: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
  suspect: {fileID: 1866291023}
  cam: {fileID: 2104728865}
  camOnSuspect: {fileID: 1990140211}
  camOnHero: {fileID: 830369994}
  camWide: {fileID: 1733419280}
  probability: 35
  stress: 45
  successThreshold: 80
  choiceTime: 12
  nodes:
  - id: m1
    lines:
    - "\u0421\u0430\u0434\u0438\u0441\u044C. \u0411\u0443\u0434\u0435\u0448\u044C \u043F\u0438\u0432\u043E? \u0422\u044B \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0441 \u0434\u043E\u043F\u0440\u043E\u0441\u0430."
    choices:
    - slot: 0
      label: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
      heroLine: "\u042F \u043D\u0430\u0448\u0451\u043B \u0443 \u043E\u0442\u0446\u0430 \u043F\u043E\u0434 \u043A\u0440\u043E\u0432\u0430\u0442\u044C\u044E \u0437\u0430\u043F\u0438\u0441\u043A\u0443. \u0422\u0432\u043E\u0439 \u043F\u043E\u0447\u0435\u0440\u043A: \xAB\u041F\u0430\u043F\u0430, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u041B\u0451\u0448\u0435. \u042F \u0432\u0441\u0451 \u0432\u0435\u0440\u043D\u0443 \u0434\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u044B\xBB."
      probability: 20
      stress: 20
      next: m2
      requires: clue_secret_note
      reply: "\u2026\u0422\u044B \u0440\u044B\u043B\u0441\u044F \u0443 \u043D\u0435\u0433\u043E \u0432 \u0441\u043F\u0430\u043B\u044C\u043D\u0435?"
    - slot: 1
      label: "\u0413\u0434\u0435 \u0442\u044B \u0431\u044B\u043B?"
      heroLine: "\u0413\u0434\u0435 \u0442\u044B \u0431\u044B\u043B \u0432\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C, \u041C\u0438\u0448\u0430?"
      probability: 5
      stress: 10
      next: m2
      requires: 
      reply: "\u0414\u043E\u043C\u0430. \u0413\u0434\u0435 \u0435\u0449\u0451. \u0425\u043E\u043A\u043A\u0435\u0439 \u0441\u043C\u043E\u0442\u0440\u0435\u043B."
    - slot: 2
      label: "\u041A\u0430\u043A \u0442\u044B?"
      heroLine: "\u041A\u0430\u043A \u0442\u044B? \u0414\u0435\u0440\u0436\u0438\u0448\u044C\u0441\u044F?"
      probability: 0
      stress: -15
      next: m2
      requires: 
      reply: "\u041A\u0430\u043A\u2026 \u041D\u0435 \u0441\u043F\u0430\u043B. \u0412\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0437\u0432\u043E\u043D\u044E \u0435\u043C\u0443."
  - id: m2
    lines:
    - "\u042F \u0436\u0435 \u0442\u0435\u0431\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u2014 \u043E\u0442\u0435\u0446 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0441\u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430. \u042F \u0441\u0440\u0430\u0437\u0443 \u0442\u0435\u0431\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B."
    choices:
    - slot: 0
      label: "\u0413\u043E\u0441\u0442\u0435\u043C \u0431\u044B\u043B \u0442\u044B"
      heroLine: "\u0414\u0432\u0435 \u0447\u0430\u0448\u043A\u0438 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435. \u0413\u043E\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043E\u043D \u0441\u0430\u043C \u043D\u0430\u043B\u0438\u043B \u043A\u043E\u0444\u0435. \u042D\u0442\u043E \u0431\u044B\u043B \u0442\u044B, \u041C\u0438\u0448\u0430."
      probability: 20
      stress: 20
      next: m3
      requires: concl_betrayal
      reply: "\u042F\u2026 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0448\u0451\u043B. \u041E\u043D \u0441\u0430\u043C \u043D\u0430\u043B\u0438\u043B."
    - slot: 1
      label: "\u0420\u0430\u0441\u043F\u0438\u0441\u043A\u0438"
      heroLine: "\u0421\u0451\u043C\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438. \u0422\u044B \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u043F\u0430\u043F\u0438\u043D\u044B \u0447\u0430\u0441\u044B."
      probability: 15
      stress: 15
      next: m3
      requires: clue_receipts
      reply: "\u0421\u0451\u043C\u0430\u2026 \u041A\u0440\u044B\u0441\u0430."
    - slot: 2
      label: "\u0411\u043B\u0435\u0444\u043E\u0432\u0430\u0442\u044C"
      heroLine: "\u0421\u043E\u0441\u0435\u0434\u043A\u0430 \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0430\u043A \u0442\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u043A \u043D\u0435\u043C\u0443 \u0432\u0435\u0447\u0435\u0440\u043E\u043C."
      probability: 5
      stress: 15
      next: m3
      requires: 
      reply: "\u041A\u0430\u043A\u0430\u044F \u0441\u043E\u0441\u0435\u0434\u043A\u0430? \u041E\u043D\u0430 \u0441\u043B\u0435\u043F\u0430\u044F \u043D\u0430 \u043E\u0434\u0438\u043D \u0433\u043B\u0430\u0437!"
    - slot: 3
      label: "\u0414\u0435\u043D\u044C\u0433\u0438"
      heroLine: "\u0422\u044B \u043E\u043F\u044F\u0442\u044C \u0438\u0433\u0440\u0430\u0435\u0448\u044C? \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D?"
      probability: 10
      stress: 10
      next: m3
      requires: 
      reply: "\u042D\u0442\u043E \u043D\u0435 \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E."
  - id: m3
    lines:
    - "\u041B\u0430\u0434\u043D\u043E. \u0414\u0430. \u042F \u0431\u044B\u043B \u0442\u0430\u043C. \u042F \u0434\u043E\u043B\u0436\u0435\u043D \u043B\u044E\u0434\u044F\u043C \u0420\u0435\u0437\u043E. \u041C\u043D\u043E\u0433\u043E."
    choices:
    - slot: 0
      label: "\u0427\u0442\u043E \u0442\u044B \u0438\u043C \u043E\u0442\u0434\u0430\u043B?"
      heroLine: "\u0427\u0442\u043E \u0442\u044B \u0438\u043C \u043E\u0442\u0434\u0430\u043B, \u041C\u0438\u0448\u0430?"
      probability: 10
      stress: 5
      next: m4
      requires: 
      reply: "\u041F\u0438\u0441\u044C\u043C\u043E \u0431\u044B\u043B\u043E \u043E\u0442 \u043D\u0438\u0445. \u041E\u0442\u0435\u0446 \u0432\u0438\u0434\u0435\u043B, \u043A\u0442\u043E \u043F\u043E\u0434\u0436\u0451\u0433 \u0441\u043A\u043B\u0430\u0434. \u041E\u043D\u0438 \u0445\u043E\u0442\u0435\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043C\u043E\u043B\u0447\u0430\u043B\u2026 \u0410 \u044F \u0441\u043A\u0430\u0437\u0430\u043B \u0438\u043C, \u0447\u0442\u043E \u043E\u043D \u0445\u043E\u0434\u0438\u043B \u0432 \u043F\u043E\u043B\u0438\u0446\u0438\u044E."
    - slot: 1
      label: "\u0423\u0434\u0430\u0440\u0438\u0442\u044C \u043F\u043E \u0441\u0442\u043E\u043B\u0443"
      heroLine: "\u0422\u044B \u0441\u0434\u0430\u043B \u043E\u0442\u0446\u0430 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C?!"
      probability: -10
      stress: 25
      next: m4
      requires: 
      reply: "\u042F \u043D\u0435 \u0441\u0434\u0430\u0432\u0430\u043B! \u042F \u0434\u0443\u043C\u0430\u043B, \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0438\u043F\u0443\u0433\u043D\u0443\u0442!"
    - slot: 2
      label: "\u041F\u043E\u043D\u044F\u0442\u044C"
      heroLine: "\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u0422\u044B \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0441\u044F. \u0413\u043E\u0432\u043E\u0440\u0438 \u2014 \u044F \u043F\u043E\u043C\u043E\u0433\u0443."
      probability: 10
      stress: -15
      next: m4
      requires: 
      reply: "\u0422\u044B \u043D\u0435 \u043F\u043E\u0439\u043C\u0451\u0448\u044C\u2026 \u041E\u043D\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438: \u0438\u043B\u0438 \u043E\u043D, \u0438\u043B\u0438 \u044F."
  - id: m4
    lines:
    - "\u041E\u043D\u0438 \u0443\u0432\u0435\u0437\u043B\u0438 \u0435\u0433\u043E. \u042F \u043D\u0435 \u0437\u043D\u0430\u044E \u043A\u0443\u0434\u0430. \u041A\u043B\u044F\u043D\u0443\u0441\u044C."
    choices:
    - slot: 0
      label: "\u0421\u043C\u043E\u0442\u0440\u0438 \u0432 \u0433\u043B\u0430\u0437\u0430"
      heroLine: "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043C\u043D\u0435 \u0432 \u0433\u043B\u0430\u0437\u0430."
      probability: 10
      stress: 15
      next: END
      requires: 
      reply: 
    - slot: 1
      label: "\u0412\u044B\u0442\u0430\u0449\u0438\u043C \u0432\u043C\u0435\u0441\u0442\u0435"
      heroLine: "\u041E\u043D \u043D\u0430\u0448 \u043E\u0442\u0435\u0446. \u041C\u044B \u0432\u044B\u0442\u0430\u0449\u0438\u043C \u0435\u0433\u043E \u0432\u043C\u0435\u0441\u0442\u0435. \u0413\u0434\u0435 \u043E\u043D?"
      probability: 15
      stress: -10
      next: END
      requires: 
      reply: 
    - slot: 2
      label: "\u0421\u043A\u043B\u0430\u0434 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442"
      heroLine: "\u0421\u043A\u043B\u0430\u0434 \u0440\u0435\u0444\u0440\u0438\u0436\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442-\u0441\u0442\u0440\u0438\u0442. \u042F \u0443\u0436\u0435 \u0437\u043D\u0430\u044E. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0440\u0435\u043C\u044F \u0438 \u0432\u0445\u043E\u0434."
      probability: 20
      stress: 5
      next: END
      requires: clue_warehouse
      reply: 
    - slot: 3
      label: "\u0417\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C"
      heroLine: "\u041C\u0438\u0445\u0430\u0438\u043B \u0412\u043E\u043B\u043A\u043E\u0432, \u0432\u044B \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D\u044B."
      probability: -15
      stress: 20
      next: END
      requires: 
      reply: 
  successTitle: "\u041C\u0418\u0425\u0410\u0418\u041B \u041F\u0420\u0418\u0417\u041D\u0410\u041B\u0421\u042F"
  failTitle: "\u041F\u041B\u041E\u0425\u0410\u042F \u041A\u041E\u041D\u0426\u041E\u0412\u041A\u0410: \u0422\u042B \u041E\u041F\u041E\u0417\u0414\u0410\u041B"
  shutdownTitle: "\u041F\u041B\u041E\u0425\u0410\u042F \u041A\u041E\u041D\u0426\u041E\u0412\u041A\u0410: \u0411\u0420\u0410\u0422 \u0421\u0411\u0415\u0416\u0410\u041B"
  successText: "\u041C\u0438\u0445\u0430\u0438\u043B \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F: \xAB\u0421\u043A\u043B\u0430\u0434 \u0440\u0435\u0444\u0440\u0438\u0436\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442-\u0441\u0442\u0440\u0438\u0442. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u043E\u0447\u044C\u044E \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0437\u0443\u0442\xBB. \u0411\u0440\u0430\u0442\u044C\u044F \u0435\u0434\u0443\u0442 \u0432\u043C\u0435\u0441\u0442\u0435 \u2014 \u041C\u0438\u0445\u0430\u0438\u043B \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435 \u0437\u0430\u0434\u043D\u0438\u0439 \u0432\u0445\u043E\u0434 \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0430\u043C \u043B\u044E\u0434\u0435\u0439.\n\u041F\u043E\u0434 \u0443\u0442\u0440\u043E \u043E\u0442\u0435\u0446 \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u043C \u0441\u0438\u0434\u0435\u043D\u044C\u0435 \u2014 \u0436\u0438\u0432\u043E\u0439. \u041C\u0438\u0445\u0430\u0438\u043B \u0434\u0430\u0451\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0442\u0438\u0432 \u0420\u0435\u0437\u043E. \u0421\u0435\u043C\u044C\u044F \u0441\u043D\u043E\u0432\u0430 \u0432\u043C\u0435\u0441\u0442\u0435 \u2014 \u043A\u0430\u043A\u043E\u0439 \u0431\u044B \u0446\u0435\u043D\u043E\u0439 \u044D\u0442\u043E \u043D\u0438 \u0434\u0430\u043B\u043E\u0441\u044C."
  failText: "\u041C\u0438\u0445\u0430\u0438\u043B \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u0435\u0431\u044F \u0437\u0430 \u0434\u0432\u0435\u0440\u044C \u0438 \u0442\u0443\u0442 \u0436\u0435 \u043A\u043E\u043C\u0443-\u0442\u043E \u0437\u0432\u043E\u043D\u0438\u0442. \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0441\u043A\u043B\u0430\u0434 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442-\u0441\u0442\u0440\u0438\u0442 \u043F\u0443\u0441\u0442. \u041E\u0442\u0446\u0430 \u0442\u0430\u043C \u0443\u0436\u0435 \u043D\u0435\u0442."
  shutdownText: "\u041C\u0438\u0445\u0430\u0438\u043B \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441\u0443\u043C\u043A\u0443 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442 \u043F\u043E \u043F\u043E\u0436\u0430\u0440\u043D\u043E\u0439 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435. \u0422\u044B \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F \u043E\u0434\u0438\u043D \u0432 \u043F\u0443\u0441\u0442\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u0441 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u043C \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440\u043E\u043C."
  endingTag: "\u041B\u0423\u0427\u0428\u0410\u042F \u041A\u041E\u041D\u0426\u041E\u0412\u041A\u0410: \u0421\u0415\u041C\u042C\u042F"
  grantId: 
  grantTitle: 
  grantText: 
  returnScene: 02_Precinct
