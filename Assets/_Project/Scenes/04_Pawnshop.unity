MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1636784601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35b03f60472157540a422032ecd32a7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarXCase.Precinct.Interrogation
  suspectName: "\u0421\u0401\u041C\u0410"
  heroName: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
  suspect: {fileID: 1750387006}
  cam: {fileID: 409783932}
  camOnSuspect: {fileID: 827822365}
  camOnHero: {fileID: 1753941731}
  camWide: {fileID: 672347402}
  probability: 45
  stress: 50
  successThreshold: 65
  choiceTime: 12
  nodes:
  - id: s1
    lines:
    - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439?! \u041E\u0445\u2026 \u042F \u0434\u0443\u043C\u0430\u043B, \u044D\u0442\u043E \u0432\u0430\u0448 \u043E\u0442\u0435\u0446 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F."
    choices:
    - slot: 0
      label: "\u0427\u0442\u043E \u0443 \u0441\u0435\u0439\u0444\u0430?"
      heroLine: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0437\u0430\u043A\u0440\u044B\u0442. \u0427\u0442\u043E \u0442\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C \u0443 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0441\u0435\u0439\u0444\u0430 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435?"
      probability: 10
      stress: 15
      next: s2
      requires: 
      reply: "\u042F\u2026 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B. \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u043B, \u0435\u0441\u043B\u0438 \u0447\u0442\u043E, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
    - slot: 1
      label: "\u0423\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C"
      heroLine: "\u0422\u0438\u0445\u043E, \u0421\u0451\u043C\u0430. \u042F \u043D\u0435 \u0437\u0430 \u0442\u043E\u0431\u043E\u0439. \u042F \u0438\u0449\u0443 \u043E\u0442\u0446\u0430."
      probability: 5
      stress: -15
      next: s2
      requires: 
      reply: "\u0421\u043B\u0430\u0432\u0430 \u0431\u043E\u0433\u0443\u2026 \u042F \u0441\u0430\u043C \u0435\u0433\u043E \u0438\u0449\u0443 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0435\u043D\u044C."
    - slot: 2
      label: "\u0420\u0443\u043A\u0438 \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A"
      heroLine: "\u0420\u0443\u043A\u0438 \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
      probability: -5
      stress: 25
      next: s2
      requires: 
      reply: "\u0412\u044B \u0447\u0442\u043E?! \u042F \u0442\u0443\u0442 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u044E!"
  - id: s2
    lines:
    - "\u041F\u043E\u0437\u0430\u0432\u0447\u0435\u0440\u0430 \u043E\u043D \u0437\u0430\u043A\u0440\u044B\u043B \u043A\u0430\u0441\u0441\u0443 \u0440\u0430\u043D\u044C\u0448\u0435. \u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0435\u043C\u0443 \u043D\u0430\u0434\u043E \u043A\u043E\u0435-\u0447\u0442\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C."
    choices:
    - slot: 0
      label: "\u0422\u0430\u0439\u043D\u0438\u043A"
      heroLine: "\u041A\u043B\u044E\u0447\u0438 \u043E\u0442 \u043B\u043E\u043C\u0431\u0430\u0440\u0434\u0430 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0434\u043E\u043C\u0430, \u0444\u043E\u0442\u043E \u043F\u0440\u043E\u043F\u0430\u043B\u043E \u0438\u0437 \u0440\u0430\u043C\u043A\u0438. \u041E\u043D \u0447\u0442\u043E-\u0442\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u0437\u0434\u0435\u0441\u044C. \u0413\u0434\u0435?"
      probability: 15
      stress: 5
      next: s3
      requires: concl_pawnshop
      reply: "\u0412 \u0441\u0435\u0439\u0444\u0435 \u0435\u0441\u0442\u044C \u0432\u0442\u043E\u0440\u043E\u0435 \u0434\u043D\u043E. \u042F \u043A\u0430\u043A \u0440\u0430\u0437\u2026 \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    - slot: 1
      label: "\u0427\u0442\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C?"
      heroLine: "\u0427\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043D \u0445\u043E\u0442\u0435\u043B \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C?"
      probability: 5
      stress: 0
      next: s3
      requires: 
      reply: "\u041D\u0435 \u0437\u043D\u0430\u044E! \u041F\u0430\u043F\u043A\u0443 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E. \u0411\u0443\u043C\u0430\u0433\u0438."
    - slot: 2
      label: "\u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F"
      heroLine: "\u0418\u0437 \u0440\u0430\u043C\u043A\u0438 \u043F\u0440\u043E\u043F\u0430\u043B\u043E \u043D\u0430\u0448\u0435 \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u0435 \u0444\u043E\u0442\u043E. \u0422\u044B \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u043B?"
      probability: 10
      stress: 5
      next: s3
      requires: clue_photo
      reply: "\u0424\u043E\u0442\u043E\u2026 \u041E\u043D \u043A\u043B\u0430\u043B \u0435\u0433\u043E \u0432 \u0441\u0435\u0439\u0444. \u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438."
  - id: s3
    lines:
    - "\u0422\u0430\u043C\u2026 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438. \u0412\u0430\u0448 \u0431\u0440\u0430\u0442 \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u0447\u0430\u0441\u044B \u043E\u0442\u0446\u0430. \u0422\u0440\u0438 \u0440\u0430\u0437\u0430. \u041E\u0442\u0435\u0446 \u0432\u0441\u0451 \u0432\u044B\u043A\u0443\u043F\u0430\u043B."
    choices:
    - slot: 0
      label: "\u041A\u0430\u043A\u043E\u0439 \u0431\u0440\u0430\u0442?"
      heroLine: "\u041A\u0430\u043A\u043E\u0439 \u0431\u0440\u0430\u0442, \u0421\u0451\u043C\u0430? \u0414\u043C\u0438\u0442\u0440\u0438\u0439?"
      probability: 10
      stress: 5
      next: s4
      requires: 
      reply: "\u041D\u0435\u0442. \u041C\u0438\u0445\u0430\u0438\u043B. \u041E\u043D \u0431\u0440\u0430\u043B \u0434\u0435\u043D\u044C\u0433\u0438 \u0443 \u043F\u043B\u043E\u0445\u0438\u0445 \u043B\u044E\u0434\u0435\u0439."
    - slot: 1
      label: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u043E\u043B\u0447\u0430\u043B?"
      heroLine: "\u0422\u044B \u0437\u043D\u0430\u043B \u0438 \u043C\u043E\u043B\u0447\u0430\u043B?"
      probability: -5
      stress: 15
      next: s4
      requires: 
      reply: "\u042D\u0442\u043E \u043D\u0435 \u043C\u043E\u0451 \u0434\u0435\u043B\u043E! \u041E\u0442\u0435\u0446 \u043F\u0440\u043E\u0441\u0438\u043B \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
    - slot: 2
      label: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0439 \u0441\u0435\u0439\u0444"
      heroLine: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0439 \u0441\u0435\u0439\u0444. \u0421\u0435\u0439\u0447\u0430\u0441."
      probability: 5
      stress: 10
      next: s4
      requires: 
      reply: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0445\u043E\u0440\u043E\u0448\u043E\u2026 \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043A\u0440\u0438\u0447\u0438\u0442\u0435."
  - id: s4
    lines:
    - "\u0412\u0447\u0435\u0440\u0430 \u0437\u0430\u0445\u043E\u0434\u0438\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0421\u043E \u0448\u0440\u0430\u043C\u043E\u043C. \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B \u043E\u0442\u0446\u0430. \u0421\u043A\u0430\u0437\u0430\u043B \u2014 \u043E\u0442 \u0420\u0435\u0437\u043E."
    choices:
    - slot: 0
      label: "\u041E\u043F\u0438\u0448\u0438 \u0435\u0433\u043E"
      heroLine: "\u041E\u043F\u0438\u0448\u0438 \u0435\u0433\u043E. \u041A\u0430\u0436\u0434\u0443\u044E \u043C\u0435\u043B\u043E\u0447\u044C."
      probability: 15
      stress: -5
      next: END
      requires: 
      reply: 
    - slot: 1
      label: "\u0422\u044B \u0447\u0442\u043E-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B?"
      heroLine: "\u0422\u044B \u0441\u043A\u0430\u0437\u0430\u043B \u0435\u043C\u0443, \u0433\u0434\u0435 \u0436\u0438\u0432\u0451\u0442 \u043E\u0442\u0435\u0446?"
      probability: 5
      stress: 20
      next: END
      requires: 
      reply: 
    - slot: 2
      label: "\u0423\u0435\u0437\u0436\u0430\u0439"
      heroLine: "\u0417\u0430\u043A\u0440\u043E\u0439 \u043B\u043E\u043C\u0431\u0430\u0440\u0434 \u0438 \u0443\u0435\u0437\u0436\u0430\u0439 \u043A \u0441\u0435\u0441\u0442\u0440\u0435. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0436\u0435."
      probability: 10
      stress: -15
      next: END
      requires: 
      reply: 
  successTitle: "\u0421\u0401\u041C\u0410 \u041E\u0422\u041A\u0420\u042B\u041B \u0421\u0415\u0419\u0424"
  failTitle: "\u0421\u0401\u041C\u0410 \u041F\u0420\u041E\u041C\u041E\u041B\u0427\u0410\u041B"
  shutdownTitle: "\u0414\u041E\u041F\u0420\u041E\u0421 \u0421\u041E\u0420\u0412\u0410\u041D"
  successText: "\u0412\u043E \u0432\u0442\u043E\u0440\u043E\u043C \u0434\u043D\u0435 \u0441\u0435\u0439\u0444\u0430 \u2014 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438 \u041C\u0438\u0445\u0430\u0438\u043B\u0430: \u0442\u0440\u0438\u0436\u0434\u044B \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u043E\u0442\u0446\u043E\u0432\u0441\u043A\u0438\u0435 \u0447\u0430\u0441\u044B, \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043E\u0442\u0435\u0446 \u0438\u0445 \u0432\u044B\u043A\u0443\u043F\u0430\u043B. \u0420\u044F\u0434\u043E\u043C \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u0435 \u0444\u043E\u0442\u043E \u0438 \u0430\u0434\u0440\u0435\u0441 \u0441\u043A\u043B\u0430\u0434\u0430 \u043D\u0430 \u0412\u0430\u043D-\u0411\u0440\u0430\u043D\u0442-\u0441\u0442\u0440\u0438\u0442.\n\u041E\u0442\u0435\u0446 \u0441\u043E\u0431\u0438\u0440\u0430\u043B \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u2014 \u0438 \u043C\u043E\u043B\u0447\u0430\u043B, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u0441\u044B\u043D\u0430."
  failText: "\u0421\u0451\u043C\u0430 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0435 \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0430\u0434\u0432\u043E\u043A\u0430\u0442\u0430. \u0421\u0435\u0439\u0444 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C \u2014 \u0430 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C \u0438 \u0442\u0430\u0439\u043D\u0430 \u043B\u043E\u043C\u0431\u0430\u0440\u0434\u0430."
  shutdownText: "\u0421\u0451\u043C\u0430 \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u0432\u044B\u0431\u0435\u0433\u0430\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u0447\u0451\u0440\u043D\u044B\u0439 \u0445\u043E\u0434. \u0418\u0449\u0438 \u0435\u0433\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0411\u0440\u0430\u0439\u0442\u043E\u043D\u0443."
  endingTag: "\u041D\u0410 \u0414\u041E\u0421\u041A\u0415 \u0423\u041B\u0418\u041A \u0414\u041E\u0421\u0422\u0423\u041F\u041D\u0410 \u041D\u041E\u0412\u0410\u042F \u0421\u0412\u042F\u0417\u041A\u0410"
  grantId: clue_receipts
  grantTitle: "\u0420\u0430\u0441\u043F\u0438\u0441\u043A\u0438 \u041C\u0438\u0445\u0430\u0438\u043B\u0430"
  grantText: "\u0412 \u0441\u0435\u0439\u0444\u0435 \u043B\u043E\u043C\u0431\u0430\u0440\u0434\u0430: \u041C\u0438\u0445\u0430\u0438\u043B \u0442\u0440\u0438\u0436\u0434\u044B \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u043E\u0442\u0446\u043E\u0432\u0441\u043A\u0438\u0435 \u0447\u0430\u0441\u044B. \u041E\u0442\u0435\u0446 \u0432\u044B\u043A\u0443\u043F\u0430\u043B \u0438\u0445 \u0438 \u043C\u043E\u043B\u0447\u0430\u043B."
  returnScene: 02_Precinct
